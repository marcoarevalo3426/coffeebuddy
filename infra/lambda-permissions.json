{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-southeast-2:184452325148:*"
    },
    {
      "Sid": "DynamoDB",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:GetItem"
      ],
      "Resource": "arn:aws:dynamodb:ap-southeast-2:184452325148:table/coffee-buddy-history"
    },
    {
      "Sid": "SlackSecrets",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:ap-southeast-2:184452325148:parameter/coffee-buddy/slack-bot-token",
        "arn:aws:ssm:ap-southeast-2:184452325148:parameter/coffee-buddy/slack-signing-secret"
      ]
    }
  ]
}
